{
  "name": "ai-film-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r build",
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "check": "vp check",
    "serve": "node apps/server/src/cli.ts serve --port 4310"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
